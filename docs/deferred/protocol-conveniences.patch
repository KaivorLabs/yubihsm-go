+func TestCurrentProtocolConstants(t *testing.T) {
+	if CommandTypeGetDevicePubKey != 0x0a || CommandTypeSignSSHCertificate != 0x5d ||
+		CommandTypeImportRSAWrapped != 0x77 {
+		t.Fatal("command constants do not match the YubiHSM protocol")
+	}
+	if AlgorithmRSAPKCS1Decrypt != 48 || AlgorithmECP256YubicoAuth != 49 || AlgorithmAESKWP != 55 {
+		t.Fatal("algorithm constants do not match the YubiHSM protocol")
+	}
+	if CapabilityPutSymmetricKey != uint64(1)<<47 || CapabilityDeletePublicWrapKey != uint64(1)<<55 {
+		t.Fatal("capability constants do not match the YubiHSM protocol")
+	}
+	if ObjectTypeSymmetricKey != 0x08 || ObjectTypePublicWrapKey != 0x84 {
+		t.Fatal("object type constants do not match the YubiHSM protocol")
+	}
+}
